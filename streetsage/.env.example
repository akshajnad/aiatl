# StreetSage Configuration
# Copy to .env and fill in your credentials

# ElevenLabs TTS API
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Snowflake Connection
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=STREETSAGE
SNOWFLAKE_SCHEMA=PUBLIC

# Video Source
# Options:
#   0 = laptop webcam (default)
#   rtsp://192.168.1.100:8080/h264_ulaw.sdp = RTSP stream
#   http://192.168.1.100:8080/video = MJPEG stream
VIDEO_SOURCE=0

# Processing Settings
FRAME_RATE=3
DETECTION_CONFIDENCE=0.35
INSTRUCTION_CADENCE_SEC=3.0

# Audio Settings
ENABLE_TTS=true
ENABLE_STT=true
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL  # Default voice (Rachel)

# Logging
LOG_TO_SNOWFLAKE=true
SESSION_ID=local_dev
